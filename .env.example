# Kopie nach .env.local, Werte eintragen. Nie committen.

# Supabase (Projekt rhythm-gym, Region eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Stripe (Kaufweg, KW41–42)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Bunny Stream (Kursvideos)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Brevo — Briefe aus der Schule (siehe docs/handpan-schule/brevo-setup.md)
# API-Schlüssel aus Brevo → SMTP & API. Ohne Schlüssel antwortet /api/briefe mit 503.
BREVO_API_KEY=
# Nummer der Liste „Briefe" (Kontakte → Listen, Zahl in der URL)
BREVO_LIST_BRIEFE_ID=
# Nummer der Double-Opt-in-Vorlage (Kampagnen → Vorlagen)
BREVO_DOI_TEMPLATE_ID=

# Supabase service_role — NUR serverseitig, hebelt jede RLS-Regel aus.
# Supabase → Project Settings → API → service_role. Niemals mit NEXT_PUBLIC_-
# Präfix und niemals ins Frontend. Heute genau ein Nutzer: der Stripe-Webhook
# (app/api/stripe/webhook/route.ts) über app/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe-Webhook-Signatur (Signing Secret, beginnt mit whsec_).
# Stripe → Developers → Webhooks → den Endpunkt anklicken → Signing secret.
# Pro Endpunkt eigen: Test-Modus, Produktion und `stripe listen` haben je ein
# anderes. Ohne diesen Wert antwortet /api/stripe/webhook mit 503.
STRIPE_WEBHOOK_SECRET=
